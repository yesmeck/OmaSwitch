#!/usr/bin/env bash

set -u

usage() {
  printf 'Usage: %s switches | status | toggle <switch-id> | action <action-id>\n' "$0" >&2
  exit 2
}

plugin_dir() {
  cd "$(dirname "${BASH_SOURCE[0]}")" && pwd
}

built_in_switches_file() {
  printf '%s/switches.json\n' "$(plugin_dir)"
}

custom_switches_file() {
  printf '%s/omaswitch/switches.json\n' "${XDG_CONFIG_HOME:-${HOME}/.config}"
}

valid_custom_entries() {
  local config reserved
  config="$(custom_switches_file)"
  [[ -f "$config" ]] || return 0
  reserved="$(jq -c '[.[].id]' "$(built_in_switches_file)")"

  jq -c --argjson reserved "$reserved" '
    def command:
      type == "array" and length > 0 and
      (.[0] | type == "string" and length > 0) and
      all(.[]; type == "string");

    if type != "array" then empty else
      .[]
      | select(type == "object")
      | select((.id | type) == "string")
      | select(.id | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
      | select(.id as $id | ($reserved | index($id)) == null)
      | select((.label | type) == "string" and (.label | length) > 0)
      | select(
          if has("actionCommand") then
            (.actionCommand | command)
          else
            (.statusCommand | command) and (.toggleCommand | command)
          end
        )
    end
  ' "$config" 2>/dev/null
}

all_switch_entries() {
  jq -c '.[] | . + {custom: false}' "$(built_in_switches_file)"
  valid_custom_entries | jq -c '. + {custom: true}'
}

switches() {
  all_switch_entries | jq -sc '
    reduce .[] as $item ([];
      if any(.[]; .key == $item.id) then .
      else . + [{
        key: $item.id,
        label: $item.label,
        icon: ($item.icon // ""),
        iconSource: ($item.iconSource // ""),
        on: ($item.onLabel // "On"),
        off: ($item.offLabel // (if $item.actionCommand then "Run action" else "Off" end)),
        action: ($item.action == true or $item.actionCommand != null),
        clientAction: ($item.clientAction // ""),
        custom: $item.custom
      }]
      end
    )
  '
}

switch_entry() {
  local id="$1"
  all_switch_entries | jq -sc --arg id "$id" \
    'first(.[] | select(.id == $id)) // empty'
}

run_json_command() {
  local entry="$1"
  local field="$2"
  local -a command=()

  mapfile -d '' -t command < <(
    jq -j --arg field "$field" '.[$field][] | ., "\u0000"' <<<"$entry"
  )
  ((${#command[@]} > 0)) || return 1
  local root i
  root="$(plugin_dir)"
  for i in "${!command[@]}"; do
    command[$i]="${command[$i]//\$PLUGIN_DIR/$root}"
  done
  "${command[@]}"
}

status() {
  local result entry id enabled
  result='{}'

  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    jq -e '(.action == true) or has("actionCommand") or has("clientAction")' \
      <<<"$entry" >/dev/null && continue
    id="$(jq -r '.id' <<<"$entry")"
    enabled=false
    run_json_command "$entry" statusCommand >/dev/null 2>&1 && enabled=true
    result="$(jq -c --arg id "$id" --argjson enabled "$enabled" \
      '. + {($id): $enabled}' <<<"$result")"
  done < <(all_switch_entries)

  printf '%s\n' "$result"
}

toggle() {
  local entry
  entry="$(switch_entry "${1:-}")"
  [[ -n "$entry" ]] || usage
  jq -e 'has("toggleCommand") and (has("clientAction") | not)' \
    <<<"$entry" >/dev/null || usage
  run_json_command "$entry" toggleCommand
}

action() {
  local entry
  entry="$(switch_entry "${1:-}")"
  [[ -n "$entry" ]] || usage
  jq -e 'has("actionCommand")' <<<"$entry" >/dev/null || usage
  run_json_command "$entry" actionCommand
}

case "${1:-}" in
  switches) switches ;;
  status) status ;;
  toggle) toggle "${2:-}" ;;
  action) action "${2:-}" ;;
  *) usage ;;
esac
