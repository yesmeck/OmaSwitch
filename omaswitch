#!/usr/bin/env bash

set -u

usage() {
  printf 'Usage: %s switches | status | toggle <switch-id> | action <action-id>\n' "$0" >&2
  exit 2
}

bool_command() {
  "$@" >/dev/null 2>&1
}

custom_switches_file() {
  printf '%s/omaswitch/switches.json\n' "${XDG_CONFIG_HOME:-${HOME}/.config}"
}

valid_custom_entries() {
  local config
  config="$(custom_switches_file)"
  [[ -f "$config" ]] || return 0

  jq -c '
    def command:
      type == "array" and length > 0 and
      (.[0] | type == "string" and length > 0) and
      all(.[]; type == "string");
    def reserved:
      . == "wifi" or . == "bluetooth" or . == "nightlight" or
      . == "awake" or . == "dnd" or . == "bar" or
      . == "clean" or . == "hidden-files" or . == "lock" or
      . == "screensaver";

    if type != "array" then empty else
      .[]
      | select(type == "object")
      | select((.id | type) == "string")
      | select(.id | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
      | select(.id | reserved | not)
      | select((.label | type) == "string" and (.label | length) > 0)
      | select(
          if has("actionCommand") then
            (.actionCommand | command)
          else
            (.statusCommand | command) and (.toggleCommand | command)
          end
        )
    end
  ' "$config" 2>/dev/null
}

switches() {
  valid_custom_entries | jq -sc '
    reduce .[] as $item ([];
      if any(.[]; .key == $item.id) then .
      else . + [{
        key: $item.id,
        label: $item.label,
        icon: ($item.icon // ""),
        on: ($item.onLabel // "On"),
        off: ($item.offLabel // (if $item.actionCommand then "Run action" else "Off" end)),
        action: ($item.actionCommand != null),
        custom: true
      }]
      end
    )
  '
}

custom_entry() {
  local id="$1"
  valid_custom_entries | jq -sc --arg id "$id" \
    'first(.[] | select(.id == $id)) // empty'
}

run_json_command() {
  local entry="$1"
  local field="$2"
  local -a command=()

  mapfile -d '' -t command < <(
    jq -j --arg field "$field" '.[$field][] | ., "\u0000"' <<<"$entry"
  )
  ((${#command[@]} > 0)) || return 1
  "${command[@]}"
}

hidden_files_enabled() {
  local state_home="${XDG_STATE_HOME:-${HOME}/.local/state}"
  [[ -f "$state_home/omaswitch/hidden-files" ]]
}

set_hidden_files() {
  local value="$1"
  local state_home="${XDG_STATE_HOME:-${HOME}/.local/state}"
  local state_dir="$state_home/omaswitch"

  mkdir -p "$state_dir"
  if [[ "$value" == "true" ]]; then
    : >"$state_dir/hidden-files"
  else
    rm -f "$state_dir/hidden-files"
  fi

  # Nautilus 50 keeps hidden-file visibility as window state and ignores the
  # old GSettings key while running. Ctrl+H is its authoritative action.
  while IFS= read -r address; do
    [[ -n "$address" ]] || continue
    hyprctl dispatch \
      "hl.dsp.send_shortcut({ mods = 'CTRL', key = 'H', window = 'address:$address' })" \
      >/dev/null
  done < <(hyprctl clients -j 2>/dev/null | jq -r '
    .[] | select(.class == "org.gnome.Nautilus") | .address
  ')

  # GTK file pickers have a separate, persistent preference.
  if gsettings list-keys org.gtk.Settings.FileChooser 2>/dev/null \
      | grep -qx show-hidden; then
    gsettings set org.gtk.Settings.FileChooser show-hidden "$value"
  fi
}

status() {
  local wifi=false bluetooth=false nightlight=false awake=false dnd=false bar=true hidden_files=false

  [[ "$(nmcli -t -f WIFI general 2>/dev/null)" == "enabled" ]] && wifi=true
  bool_command omarchy bluetooth power is-on && bluetooth=true
  omarchy toggle nightlight --status 2>/dev/null | jq -e '.enabled == true' >/dev/null 2>&1 && nightlight=true
  omarchy toggle idle status 2>/dev/null | jq -e '.enabled == false' >/dev/null 2>&1 && awake=true

  local dnd_state
  dnd_state="$(omarchy-shell notifications dndState 2>/dev/null || true)"
  [[ "$dnd_state" == *true* || "$dnd_state" == *enabled* || "$dnd_state" == *on* ]] && dnd=true

  bool_command omarchy toggle enabled bar-off && bar=false

  hidden_files_enabled && hidden_files=true

  local result entry id enabled
  result="$(printf '{"wifi":%s,"bluetooth":%s,"nightlight":%s,"awake":%s,"dnd":%s,"bar":%s,"clean":false,"hidden-files":%s}' \
    "$wifi" "$bluetooth" "$nightlight" "$awake" "$dnd" "$bar" "$hidden_files")"

  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    [[ "$(jq -r 'has("actionCommand")' <<<"$entry")" == "true" ]] && continue
    id="$(jq -r '.id' <<<"$entry")"
    enabled=false
    run_json_command "$entry" statusCommand >/dev/null 2>&1 && enabled=true
    result="$(jq -c --arg id "$id" --argjson enabled "$enabled" \
      '. + {($id): $enabled}' <<<"$result")"
  done < <(valid_custom_entries)

  printf '%s\n' "$result"
}

toggle() {
  local entry
  case "${1:-}" in
    wifi)
      if [[ "$(nmcli -t -f WIFI general 2>/dev/null)" == "enabled" ]]; then nmcli radio wifi off; else nmcli radio wifi on; fi
      ;;
    bluetooth) omarchy bluetooth power toggle ;;
    nightlight) omarchy toggle nightlight ;;
    awake) omarchy toggle idle ;;
    dnd) omarchy toggle notification silencing ;;
    bar) omarchy toggle bar ;;
    hidden-files)
      if hidden_files_enabled; then set_hidden_files false; else set_hidden_files true; fi
      ;;
    *)
      entry="$(custom_entry "${1:-}")"
      [[ -n "$entry" && "$(jq -r 'has("actionCommand")' <<<"$entry")" == "false" ]] || usage
      run_json_command "$entry" toggleCommand
      ;;
  esac
}

action() {
  local entry
  case "${1:-}" in
    lock) omarchy system lock ;;
    screensaver) omarchy launch screensaver force ;;
    *)
      entry="$(custom_entry "${1:-}")"
      [[ -n "$entry" && "$(jq -r 'has("actionCommand")' <<<"$entry")" == "true" ]] || usage
      run_json_command "$entry" actionCommand
      ;;
  esac
}

case "${1:-}" in
  switches) switches ;;
  status) status ;;
  toggle) toggle "${2:-}" ;;
  action) action "${2:-}" ;;
  *) usage ;;
esac
