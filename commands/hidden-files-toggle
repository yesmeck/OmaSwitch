#!/usr/bin/env bash

set -euo pipefail

state_home="${XDG_STATE_HOME:-${HOME}/.local/state}"
state_dir="$state_home/omaswitch"
state_file="$state_dir/hidden-files"
mkdir -p "$state_dir"

if [[ -f "$state_file" ]]; then
  rm -f "$state_file"
  value=false
else
  : >"$state_file"
  value=true
fi

# Nautilus 50 keeps hidden-file visibility as window state and ignores the
# old GSettings key while running. Ctrl+H is its authoritative action.
while IFS= read -r address; do
  [[ -n "$address" ]] || continue
  hyprctl dispatch \
    "hl.dsp.send_shortcut({ mods = 'CTRL', key = 'H', window = 'address:$address' })" \
    >/dev/null
done < <(hyprctl clients -j 2>/dev/null | jq -r '
  .[] | select(.class == "org.gnome.Nautilus") | .address
')

# GTK file pickers have a separate, persistent preference.
if gsettings list-keys org.gtk.Settings.FileChooser 2>/dev/null |
    grep -qx show-hidden; then
  gsettings set org.gtk.Settings.FileChooser show-hidden "$value"
fi
